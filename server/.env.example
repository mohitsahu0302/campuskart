# Server Environment Variables
PORT=5000
NODE_ENV=production

# MongoDB: Local or MongoDB Atlas (e.g. mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/campuskart?retryWrites=true&w=majority)
MONGODB_URI=mongodb://127.0.0.1:27017/campuskart

# JWT Auth Secret
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Frontend URL (e.g. https://your-campuskart.vercel.app or http://localhost:3000)
CLIENT_URL=http://localhost:3000

# Cloudinary Storage (Required for Vercel/Production image uploads)
# Sign up at https://cloudinary.com/ to get these from your dashboard:
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
