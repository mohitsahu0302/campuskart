# ========================================================
# CampusKart Production & Vercel Environment Variables
# ========================================================

# --- BACKEND (Vercel Server / server/.env) ---
PORT=5000
NODE_ENV=production

# MongoDB Atlas URI (Free M0 cluster from https://cloud.mongodb.com/)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/campuskart?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_campuskart_prod_2026
JWT_EXPIRES_IN=7d

# Frontend URL (Your Vercel deployment URL)
CLIENT_URL=https://your-campuskart-app.vercel.app

# Cloudinary (Get from https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# --- FRONTEND (Vercel Client / client/.env.local) ---
# Points to your deployed Express backend API URL
NEXT_PUBLIC_API_URL=https://your-campuskart-api.vercel.app/api
